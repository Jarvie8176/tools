# llm-pipeline-monitor deploy config. Copy to install/.env and adjust.
# No secrets — the dashboard is read-only (queries Prometheus over HTTP).
PORT=8896
REFRESH=5
# Bind interface. Default 127.0.0.1 (localhost only). To expose behind an edge reverse proxy over
# Tailscale, bind THIS host's tailscale0 IP — NOT 0.0.0.0, so the raw port stays off the LAN. The
# dashboard has no auth; only bind a trusted interface.
HOST=127.0.0.1
# Upstream Prometheus HTTP API base (REQUIRED). The one site-specific value — set it to your
# internal Prometheus endpoint (a tailnet-bound port or an internal reverse proxy). Example only:
LLM_PM_PROM_URL=http://prometheus.internal.example:9090
# Optional query timeout (seconds) for a single Prometheus API call.
# LLM_PM_PROM_TIMEOUT=5
