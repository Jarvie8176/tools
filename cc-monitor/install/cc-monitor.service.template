# systemd --user unit for cc-monitor (rendered by install/deploy.sh).
# Localhost-only dashboard; lightweight (stdlib http), read-only over ~/.claude + /proc.
# Kept out of cc-session's cgroup and resource-bounded to respect co-tenancy with other
# services on the host.
[Unit]
Description=cc-monitor — Claude Code session dashboard
After=network.target
# Stop a crash-loop from hammering the co-tenant host: >5 restarts in 60s -> give up.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=__CCMONITOR_BIN__ serve --host __HOST__ --port __PORT__ --refresh __REFRESH__
Restart=on-failure
RestartSec=5
# co-tenancy guardrails. The process RSS is tiny (~30M); the bulk of cgroup memory is
# reclaimable page cache from reading transcripts, so a tight hard MemoryMax causes a
# reclaim storm rather than protection. Use a soft MemoryHigh (gentle reclaim) with a
# generous hard backstop. No CPUQuota: the parse cache makes steady-state work ~0, and the
# one-time cold read must not be throttled into request timeouts; Nice yields to co-tenants.
MemoryHigh=256M
MemoryMax=512M
Nice=10

[Install]
WantedBy=default.target
