# cc-monitor deploy config. Copy to install/.env and adjust.
# No secrets — cc-monitor is read-only over local files.
PORT=8899
REFRESH=3
# Bind interface. Default 127.0.0.1 (localhost only). To expose behind an edge reverse
# proxy over Tailscale, bind THIS host's tailscale0 IP (e.g. 100.75.137.96) — NOT 0.0.0.0,
# so the raw port stays off the LAN. The dashboard has no auth; only bind a trusted iface.
HOST=127.0.0.1
