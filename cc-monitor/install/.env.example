# cc-monitor deploy config. Copy to install/.env and adjust.
# No secrets — cc-monitor is read-only over local files.
PORT=8899
# PORT_DEV: the staging instance (install/deploy-dev.sh) binds this, alongside prod on PORT.
PORT_DEV=8898
REFRESH=3
# Bind interface. Default 127.0.0.1 (localhost only). To expose behind an edge reverse
# proxy over Tailscale, bind THIS host's tailscale0 IP — NOT 0.0.0.0, so the raw port stays
# off the LAN. The dashboard has no auth; only bind a trusted interface.
HOST=127.0.0.1
# Optional: write aggregate Prometheus metrics to this file each refresh — the node-exporter
# textfile collector (runs as `nobody`) reads it off disk. Unset = disabled. Point it at the
# fleet textfile dir (ccrc-owned; the file lands 0644 via umask so `nobody` can read it).
# CC_MONITOR_METRICS_FILE=/var/lib/node-exporter/textfile_collector/cc-monitor.prom
