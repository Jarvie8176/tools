# cc-monitor deploy config. Copy to install/.env and adjust.
# No secrets — cc-monitor is read-only over local files.
PORT=8899
# PORT_DEV: the staging instance (install/deploy-dev.sh) binds this, alongside prod on PORT.
PORT_DEV=8898
REFRESH=3
# Bind interface. Default 127.0.0.1 (localhost only). To expose behind an edge reverse
# proxy over Tailscale, bind THIS host's tailscale0 IP — NOT 0.0.0.0, so the raw port stays
# off the LAN. The dashboard has no auth; only bind a trusted interface.
HOST=127.0.0.1
# Optional: write aggregate Prometheus metrics to this file each refresh, for a
# node-exporter / Alloy textfile collector to read off disk. Unset = disabled.
# Written world-readable 0644 (the service unit pins UMask=0022) so a non-root collector
# (e.g. node-exporter running as `nobody`) can read it. Only the per-session OTel sidecar is 0600.
# CC_MONITOR_METRICS_FILE=/var/lib/node-exporter/textfile_collector/cc-monitor.prom

# Optional: embedded OTLP receiver for per-session effort (the s-effort column).
#   OTEL_SINK=1  -> this instance owns the loopback OTLP receiver (:4318)
#   OTEL_SINK=0  -> --no-otel-sink (default for deploy-dev.sh; prod deploy.sh defaults 1)
# Only ONE cc-monitor instance per host may own the sink. OTEL_PORT overrides the port.
# OTEL_SINK=1
# OTEL_PORT=4318
